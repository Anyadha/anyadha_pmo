{
  "doctype": "DocType",
  "name": "PMO MIS Report Definition",
  "module": "Performance MIS",
  "custom": 0,
  "istable": 0,
  "editable_grid": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "report_name",
      "label": "Report Name",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "report_type",
      "label": "Report Type",
      "fieldtype": "Select",
      "options": "Financial\nProject\nProgramme\nM&E\nCompliance\nRisk\nGovernance\nExecutive"
    },
    {
      "fieldname": "frequency",
      "label": "Frequency",
      "fieldtype": "Select",
      "options": "Daily\nWeekly\nMonthly\nQuarterly\nAnnual\nOn Demand"
    },
    {
      "fieldname": "responsible_employee",
      "label": "Owner",
      "fieldtype": "Link",
      "options": "Employee"
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "report_code",
      "label": "Report Code",
      "fieldtype": "Data"
    },
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company"
    },
    {
      "fieldname": "entity",
      "label": "Entity",
      "fieldtype": "Link",
      "options": "PMO Entity"
    },
    {
      "fieldname": "business_unit",
      "label": "Business Unit",
      "fieldtype": "Link",
      "options": "PMO Business Unit"
    },
    {
      "fieldname": "report_source",
      "label": "Report Source",
      "fieldtype": "Data"
    },
    {
      "fieldname": "delivery_method",
      "label": "Delivery Method",
      "fieldtype": "Select",
      "options": "Dashboard\nEmail\nFile\nERPNext Report"
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1
    },
    {
      "fieldname": "last_generated_on",
      "label": "Last Generated On",
      "fieldtype": "Datetime"
    }
  ],
  "permissions": [
    {
      "role": "PMO Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "PMO Head",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "Executive / Management",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "Programme Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "Project Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 1
    }
  ]
}
