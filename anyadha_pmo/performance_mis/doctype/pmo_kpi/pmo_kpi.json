{
  "doctype": "DocType",
  "name": "PMO KPI",
  "module": "Performance MIS",
  "custom": 0,
  "istable": 0,
  "editable_grid": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "kpi_name",
      "label": "KPI Name",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "kpi_code",
      "label": "KPI Code",
      "fieldtype": "Data"
    },
    {
      "fieldname": "category",
      "label": "Category",
      "fieldtype": "Select",
      "options": "Financial\nProject\nProgramme\nM&E\nCompliance\nRisk\nGovernance\nOperational"
    },
    {
      "fieldname": "unit",
      "label": "Unit",
      "fieldtype": "Data"
    },
    {
      "fieldname": "formula",
      "label": "Formula",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "frequency",
      "label": "Frequency",
      "fieldtype": "Select",
      "options": "Monthly\nQuarterly\nAnnual"
    },
    {
      "fieldname": "section_performance",
      "label": "Performance Definition",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "direction",
      "label": "Performance Direction",
      "fieldtype": "Select",
      "options": "Higher is Better\nLower is Better\nTarget Range"
    },
    {
      "fieldname": "owner",
      "label": "KPI Owner",
      "fieldtype": "Link",
      "options": "Employee"
    },
    {
      "fieldname": "data_source",
      "label": "Data Source",
      "fieldtype": "Data"
    },
    {
      "fieldname": "calculation_method",
      "label": "Calculation Method",
      "fieldtype": "Select",
      "options": "Manual\nFormula\nERPNext Transaction\nM&E Reading\nExternal Source"
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1
    },
    {
      "fieldname": "effective_from",
      "label": "Effective From",
      "fieldtype": "Date"
    },
    {
      "fieldname": "effective_to",
      "label": "Effective To",
      "fieldtype": "Date"
    }
  ],
  "permissions": [
    {
      "role": "PMO Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "PMO Head",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "Executive / Management",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "Programme Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "Project Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 1
    }
  ]
