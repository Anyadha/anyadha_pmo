{
  "doctype": "DocType",
  "name": "PMO Approval Request",
  "module": "Governance",
  "custom": 0,
  "istable": 0,
  "editable_grid": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "request_type",
      "label": "Request Type",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "reference_doctype",
      "label": "Reference DocType",
      "fieldtype": "Data"
    },
    {
      "fieldname": "reference_name",
      "label": "Reference Name",
      "fieldtype": "Dynamic Link",
      "options": "reference_doctype"
    },
    {
      "fieldname": "requested_by",
      "label": "Requested By",
      "fieldtype": "Link",
      "options": "User"
    },
    {
      "fieldname": "requested_on",
      "label": "Requested On",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nOpen\nIn Progress\nPending Approval\nApproved\nRejected\nCompleted\nClosed\nCancelled"
    },
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company"
    },
    {
      "fieldname": "entity",
      "label": "PMO Entity",
      "fieldtype": "Link",
      "options": "PMO Entity"
    },
    {
      "fieldname": "business_unit",
      "label": "Business Unit",
      "fieldtype": "Link",
      "options": "PMO Business Unit"
    },
    {
      "fieldname": "authority_matrix",
      "label": "Authority Matrix",
      "fieldtype": "Link",
      "options": "PMO Authority Matrix"
    },
    {
      "fieldname": "approval_amount",
      "label": "Approval Amount",
      "fieldtype": "Currency"
    },
    {
      "fieldname": "approval_currency",
      "label": "Approval Currency",
      "fieldtype": "Link",
      "options": "Currency"
    },
    {
      "fieldname": "current_sequence",
      "label": "Current Sequence",
      "fieldtype": "Int",
      "default": 1
    },
    {
      "fieldname": "final_decision",
      "label": "Final Decision",
      "fieldtype": "Select",
      "options": "Pending\nApproved\nRejected\nReturned\nCancelled"
    },
    {
      "fieldname": "completed_on",
      "label": "Completed On",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "remarks",
      "label": "Remarks",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "evidence_required",
      "label": "Evidence Required",
      "fieldtype": "Check",
      "default": 0
    },
    {
      "fieldname": "evidence_complete",
      "label": "Evidence Complete",
      "fieldtype": "Check",
      "default": 0
    },
    {
      "fieldname": "override_used",
      "label": "Override Used",
      "fieldtype": "Check",
      "default": 0,
      "read_only": 1
    },
    {
      "fieldname": "override_reason",
      "label": "Override Reason",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "workflow_state",
      "label": "Workflow State",
      "fieldtype": "Data",
      "read_only": 1,
      "no_copy": 1,
      "allow_on_submit": 1
    }
  ],
  "permissions": [
    {
      "role": "PMO Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
