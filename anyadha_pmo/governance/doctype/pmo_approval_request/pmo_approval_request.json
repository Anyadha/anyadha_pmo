    },
    {
      "role": "PMO Governance Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "Executive / Management",
      "read": 1,
      "print": 1,
      "export": 1
    },
    {
      "role": "Board Member",
      "read": 1,
      "print": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 1
    }
  ],
  "field_order": [
    "request_type",
    "reference_doctype",
    "reference_name",
    "requested_by",
    "requested_on",
    "status",
    "company",
    "entity",
    "business_unit",
    "authority_matrix",
    "approval_amount",
    "approval_currency",
    "current_sequence",
