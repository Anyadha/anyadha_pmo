{
  "doctype": "DocType",
  "name": "PMO Governance Calendar",
  "module": "Governance",
  "custom": 0,
  "istable": 0,
  "editable_grid": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "activity",
      "label": "Activity",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "frequency",
      "label": "Frequency",
      "fieldtype": "Select",
      "options": "Monthly\nQuarterly\nHalf-Yearly\nAnnual\nAs Required"
    },
    {
      "fieldname": "responsible",
      "label": "Responsible",
      "fieldtype": "Link",
      "options": "Employee"
    },
    {
      "fieldname": "next_due",
      "label": "Next Due",
      "fieldtype": "Date"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nOpen\nIn Progress\nPending Approval\nApproved\nRejected\nCompleted\nClosed\nCancelled"
    }
  ],
  "permissions": [
    {
      "role": "PMO Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "PMO Head",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "Executive / Management",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "Board Member",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 1
    }
  ]
}