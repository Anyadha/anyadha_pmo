{
  "doctype": "DocType",
  "name": "PMO Strategic Plan",
  "module": "Strategy Portfolio",
  "custom": 0,
  "istable": 0,
  "editable_grid": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "plan_name",
      "label": "Plan Name",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "period_from",
      "label": "Period From",
      "fieldtype": "Date"
    },
    {
      "fieldname": "period_to",
      "label": "Period To",
      "fieldtype": "Date"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nOpen\nIn Progress\nPending Approval\nApproved\nRejected\nCompleted\nClosed\nCancelled"
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "insert_after": "plan_name"
    },
    {
      "fieldname": "entity",
      "label": "PMO Entity",
      "fieldtype": "Link",
      "options": "PMO Entity"
    },
    {
      "fieldname": "business_unit",
      "label": "Business Unit",
      "fieldtype": "Link",
      "options": "PMO Business Unit"
    },
    {
      "fieldname": "plan_code",
      "label": "Plan Code",
      "fieldtype": "Data"
    },
    {
      "fieldname": "version",
      "label": "Version",
      "fieldtype": "Int",
      "default": "1"
    },
    {
      "fieldname": "approved_by",
      "label": "Approved By",
      "fieldtype": "Link",
      "options": "User"
    },
    {
      "fieldname": "approved_on",
      "label": "Approved On",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "workflow_state",
      "label": "Workflow State",
      "fieldtype": "Data",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "PMO Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "PMO Head",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "Programme Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "Executive / Management",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 1
    },
    {
      "role": "PMO Officer",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    }
  ]
}
