{
  "doctype": "DocType",
  "name": "PMO Incident",
  "module": "Risk & Internal Controls",
  "custom": 0,
  "istable": 0,
  "editable_grid": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "incident_title",
      "label": "Incident Title",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "incident_type",
      "label": "Incident Type",
      "fieldtype": "Select",
      "options": "Operational\nFinancial\nAsset\nCyber\nSafety\nFraud\nCompliance\nOther"
    },
    {
      "fieldname": "incident_date",
      "label": "Incident Date",
      "fieldtype": "Date"
    },
    {
      "fieldname": "reported_by",
      "label": "Reported By",
      "fieldtype": "Link",
      "options": "Employee"
    },
    {
      "fieldname": "severity",
      "label": "Severity",
      "fieldtype": "Select",
      "options": "Low\nMedium\nHigh\nCritical"
    },
    {
      "fieldname": "investigation",
      "label": "Investigation",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nOpen\nIn Progress\nPending Approval\nApproved\nRejected\nCompleted\nClosed\nCancelled"
    }
  ],
  "permissions": [
    {
      "role": "PMO Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "PMO Head",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "Compliance Officer",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "Internal Auditor",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 1
    }
  ]
}